#!/bin/sh
[ -n "${ZSH_VERSION:-}" ] && emulate sh
set -eu

time_revamped_self="$0"
case "${time_revamped_self}" in
*/*) ;;
*) time_revamped_self="$(command -v -- "${time_revamped_self}")" ;;
esac
time_revamped_lib="$(cd "${time_revamped_self%/*}/../lib" && pwd)" || exit 1

for time_revamped_inherited in $(env | sed -n -e 's/^\(REVAMPED_[A-Za-z0-9_]*\)=.*/\1/p' -e 's/^\(TIME_REVAMPED_[A-Za-z0-9_]*_LOADED\)=.*/\1/p'); do
  case "${time_revamped_inherited}" in
  REVAMPED_TEST_*) continue ;;
  *) unset "${time_revamped_inherited}" ;;
  esac
done

REVAMPED_LIB="${time_revamped_lib}"
# shellcheck source=SCRIPTDIR/../lib/core.sh
. "${REVAMPED_LIB}/core.sh"
# shellcheck source=SCRIPTDIR/../lib/time.sh
. "${REVAMPED_LIB}/time.sh"

time_revamped_interface() {
  # shellcheck disable=SC2034
  REVAMPED_UI_NAME=time-revamped REVAMPED_UI_VERSION="${TIME_REVAMPED_VERSION}" REVAMPED_UI_TAGLINE="local and world clocks in the status bar"
  if [ -n "${TIME_REVAMPED_ACCENT:-}" ]; then
    # shellcheck disable=SC2034
    REVAMPED_UI_ACCENT_CHOICE="${TIME_REVAMPED_ACCENT}" REVAMPED_UI_ACCENT_NAME=TIME_REVAMPED_ACCENT
  fi
  # shellcheck source=SCRIPTDIR/../lib/cli.sh
  . "${REVAMPED_LIB}/cli.sh"
  # shellcheck source=SCRIPTDIR/../lib/doctor.sh
  . "${REVAMPED_LIB}/doctor.sh"
}

time_revamped_usage() {
  time_revamped_interface
  revamped_cli_usage_error "$1"
}

time_revamped_bad() {
  time_revamped_interface
  revamped_cli_die "$1"
}

time_revamped_help() {
  revamped_cli_help_page <<'HELP'
time-revamped - local and world clocks in the status bar

usage:
  time-revamped apply          bind the keys and fill the placeholders
  time-revamped list           print what apply would send to tmux
  time-revamped status NAME    print one placeholder: datetime, date, clock,
                               zones, local, until, elapsed, epoch, iso,
                               offset, week, doy, dst or overlap
  time-revamped card           print every figure as a table
  time-revamped menu           open the world clock menu
  time-revamped calendar       open the calendar in a tmux popup
  time-revamped copy [KIND]    copy the time as iso or epoch to the tmux
                               buffer and the system clipboard
  time-revamped mark           set the stopwatch mark
  time-revamped toggle-format  switch between 12 and 24 hour time
  time-revamped daemon         publish the placeholders on every tick, for
                               the options render mode
  time-revamped doctor         check this machine
  time-revamped version        print the version
  time-revamped help           print this page

keys:
  --menu-key KEY              the prefix key for the menu, or off
  --calendar-key KEY          the prefix key for the calendar, or off
  --copy-key KEY              the prefix key that copies the ISO time, or off
  --mark-key KEY              the prefix key that sets the mark, or off

clock:
  --date-format FORMAT        YMD, MD, DM, MDY, DMY or hide
  --time-format FORMAT        24H, 12H or hide
  --render MODE               jobs or options
  --interval SECONDS          how often render mode publishes, or minute

zones:
  --timezones LIST            zone names separated by commas or spaces
  --compact 0|1               1 prints short city labels
  --zone-labels LIST          your own labels, matched by position
  --zone-separator TEXT       text between the world clocks
  --weekend-override 0|1      0 keeps the time of day colour on weekends
  --local-label TEXT          a fixed label for the local clock
  --local-source SOURCE       timezone or geoip
  --geoip-endpoint URL        where geoip asks for the city
  --geoip-interval MINUTES    minutes between geoip requests
  --icon-position POSITION    middle or before
  --reset STYLE               the style written after each entry
  --relative-day 0|1          1 adds a +1d or -1d badge
  --work-hours 0|1            1 dims a zone outside working hours
  --work-start HOUR           the first working hour
  --work-end HOUR             the hour working time ends
  --dim-style STYLE           the style outside working hours, or none
  --primary INDEX             the zero-based index of the zone to highlight
  --primary-style STYLE       the style of that zone, or none

periods:
  --PERIOD-color STYLE        the colour of morning, day, afternoon, evening,
                              night or weekend
  --PERIOD-icon TEXT          the glyph of sunrise, morning, day, afternoon,
                              sunset, evening, night or weekend

countdown, dst and overlap:
  --countdown-target WHEN     YYYY-MM-DD or YYYY-MM-DD HH:MM
  --countdown-label TEXT      the text before the countdown
  --countdown-done TEXT       the text once the target has passed
  --dst-zone ZONE             the zone dst watches, default the local one
  --dst-horizon DAYS          how many days ahead dst looks
  --dst-label TEXT            the text before the day count
  --overlap-label TEXT        the text before the overlap window
  --overlap-none TEXT         the text when no hour is shared

output:
  --json                      list prints one JSON object
  --theme NAME                the look: kodougu, catppuccin-mocha,
                              catppuccin-latte, dracula, nord, gruvbox,
                              tokyo-night or mono

environment:
  TIME_REVAMPED_<SETTING>  the same as the option of that name, such as
                           TIME_REVAMPED_TIMEZONES for --timezones
  TIME_REVAMPED_THEME      the look, when --theme is not given
  TIME_REVAMPED_ACCENT     a colour such as #CBA6F7 for the accent
  KODOUGU_THEME            the family look, when neither is given
  KODOUGU_ACCENT           the family accent, when the tool's is unset
  NO_COLOR                 turn colour off

tmux options:
  @time_revamped_menu_key          the menu key (default M-t)
  @time_revamped_calendar_key      the calendar key (default off)
  @time_revamped_copy_key          the copy key (default off)
  @time_revamped_mark_key          the mark key (default off)
  @time_revamped_date_format       YMD, MD, DM, MDY, DMY or hide
                                   (default YMD)
  @time_revamped_time_format       24H, 12H or hide (default 24H)
  @time_revamped_timezones         the world clocks (default none)
  @time_revamped_compact           0 or 1 (default 0)
  @time_revamped_zone_labels       labels by position (default none)
  @time_revamped_zone_separator    text between clocks (default a space)
  @time_revamped_weekend_override  0 or 1 (default 1)
  @time_revamped_local_label       label of #{time_local} (default none)
  @time_revamped_local_source      timezone or geoip (default timezone)
  @time_revamped_geoip_endpoint    the city lookup URL
                                   (default https://ipinfo.io/city)
  @time_revamped_geoip_interval    minutes between lookups (default 30)
  @time_revamped_<period>_color    style of morning, day, afternoon,
                                   evening, night and weekend
                                   (default yellow, green, cyan, magenta,
                                   blue and brightblack)
  @time_revamped_<period>_icon     glyph of sunrise, morning, day,
                                   afternoon, sunset, evening, night and
                                   weekend (default none)
  @time_revamped_icon_position     middle or before (default middle)
  @time_revamped_reset             style after each entry
                                   (default #[default])
  @time_revamped_relative_day      0 or 1 (default 0)
  @time_revamped_work_hours        0 or 1 (default 0)
  @time_revamped_work_start        first working hour (default 9)
  @time_revamped_work_end          hour working time ends (default 17)
  @time_revamped_dim_style         style outside working hours, or none
                                   (default #[dim])
  @time_revamped_primary           zero-based zone index (default none)
  @time_revamped_primary_style     style of that zone, or none
                                   (default #[bold])
  @time_revamped_countdown_target  target of #{time_until} (default none)
  @time_revamped_countdown_label   text before it (default none)
  @time_revamped_countdown_done    text once it passed (default now)
  @time_revamped_dst_zone          zone dst watches (default local)
  @time_revamped_dst_horizon       days ahead (default 14)
  @time_revamped_dst_label         text before the day count (default DST)
  @time_revamped_overlap_label     text before the window
                                   (default overlap)
  @time_revamped_overlap_none      text with no shared hour
                                   (default no overlap)
  @time_revamped_render            jobs or options (default jobs)
  @time_revamped_interval          seconds between publishes in render
                                   mode, or minute (default minute)
  @revamped_theme                  the family look (default kodougu)

notes:
  The placeholders are #{time} for datetime and #{time_<name>} for each
  other name status takes. In jobs mode each runs the tool on every status
  redraw and reads the clock once. With --render options each placeholder
  reads a tmux option that a background process fills on every tick, by
  default one second after the minute changes, so a status refresh starts
  no process.
  The stopwatch mark is kept in @time_revamped_mark_epoch.

examples:
  time-revamped status zones
  time-revamped card
  time-revamped --timezones "Asia/Tokyo, Europe/London" status zones
  time-revamped list --json
HELP
}

time_revamped_show_version() {
  time_revamped_show_version_tmux=$(tmux -V 2>/dev/null) || time_revamped_show_version_tmux=missing
  printf '%s %s\n' time-revamped "${TIME_REVAMPED_VERSION}"
  printf 'tmux: %s\n' "${time_revamped_show_version_tmux#tmux }"
}

time_revamped_doctor_source() {
  time_revamped_doctor_source_path=$(command -v "$1" 2>/dev/null) || time_revamped_doctor_source_path=""
  if [ -n "${time_revamped_doctor_source_path}" ]; then
    revamped_doctor_line "$1" ok "${time_revamped_doctor_source_path}, $2"
    return 0
  fi
  revamped_doctor_line "$1" warn "$3"
}

time_revamped_doctor_popup() {
  time_revamped_popup_check
  case "${TIME_REVAMPED_POPUP_OK}" in
  1) revamped_doctor_line popup ok "tmux ${TIME_REVAMPED_TMUX} opens the calendar popup" ;;
  *) revamped_doctor_line popup warn "the calendar popup needs tmux ${TIME_REVAMPED_POPUP_SINCE} or later" ;;
  esac
}

time_revamped_doctor_clipboard() {
  for time_revamped_doctor_clipboard_tool in pbcopy wl-copy xclip; do
    if revamped_has_command "${time_revamped_doctor_clipboard_tool}"; then
      time_revamped_doctor_source "${time_revamped_doctor_clipboard_tool}" "copies a timestamp to the system clipboard" ""
      return 0
    fi
  done
  revamped_doctor_line clipboard warn "no pbcopy, wl-copy or xclip, so copy fills only the tmux buffer"
}

time_revamped_doctor_zoneinfo() {
  # shellcheck disable=SC2154
  if [ -d "${TIME_REVAMPED_ZONEINFO}" ]; then
    revamped_doctor_line zoneinfo ok "${TIME_REVAMPED_ZONEINFO}, holds the zone names"
    return 0
  fi
  revamped_doctor_line zoneinfo warn "${TIME_REVAMPED_ZONEINFO} is missing, so the zone names cannot be checked"
}

time_revamped_doctor_zones() {
  if [ -z "${TIME_REVAMPED_S_timezones}" ]; then
    revamped_doctor_line timezones ok "none configured"
    return 0
  fi
  time_revamped_doctor_zones_list=$(time_revamped_words "${TIME_REVAMPED_S_timezones}")
  time_revamped_doctor_zones_count=0 time_revamped_doctor_zones_bad=""
  while IFS= read -r time_revamped_doctor_zones_zone; do
    [ -n "${time_revamped_doctor_zones_zone}" ] || continue
    time_revamped_doctor_zones_count=$((time_revamped_doctor_zones_count + 1))
    [ -f "${TIME_REVAMPED_ZONEINFO}/${time_revamped_doctor_zones_zone}" ] || time_revamped_doctor_zones_bad="${time_revamped_doctor_zones_bad}${time_revamped_doctor_zones_bad:+ }${time_revamped_doctor_zones_zone}"
  done <<EOF
${time_revamped_doctor_zones_list}
EOF
  if [ -n "${time_revamped_doctor_zones_bad}" ]; then
    revamped_doctor_line timezones warn "unknown: ${time_revamped_doctor_zones_bad}"
    return 0
  fi
  revamped_doctor_line timezones ok "${time_revamped_doctor_zones_count} configured, every one is in ${TIME_REVAMPED_ZONEINFO}"
}

time_revamped_doctor_keys() {
  if [ -n "${TIME_REVAMPED_SKIPPED}" ]; then
    revamped_doctor_line keys warn "already bound and left alone: ${TIME_REVAMPED_SKIPPED}"
    return 0
  fi
  revamped_doctor_line keys ok "every key it binds is free or its own"
}

time_revamped_doctor_settings() {
  time_revamped_doctor_settings_rows=$(time_revamped_setting_rows)
  # shellcheck disable=SC2154
  revamped_doctor_settings "${TIME_REVAMPED_KINDS}" "${time_revamped_doctor_settings_rows}"
}

time_revamped_doctor() {
  time_revamped_plan
  revamped_doctor_tmux
  time_revamped_doctor_popup
  revamped_doctor_core_tools awk sed tr date env readlink
  time_revamped_doctor_source cal "draws the calendar popup" "without it the calendar popup is empty"
  time_revamped_doctor_clipboard
  time_revamped_doctor_source curl "asks geoip for the place label" "without it geoip is off and the local label comes from the timezone"
  time_revamped_doctor_zoneinfo
  time_revamped_doctor_zones
  time_revamped_doctor_settings
  time_revamped_doctor_keys
  revamped_doctor_gum
  revamped_doctor_finish
  [ "${REVAMPED_DOCTOR_MISSING}" -eq 0 ] || exit 1
}

time_revamped_list() {
  time_revamped_plan
  if [ -n "${time_revamped_as_json}" ]; then
    time_revamped_json
    return 0
  fi
  time_revamped_lines
}

time_revamped_apply_command() {
  time_revamped_apply
  time_revamped_apply_command_sent=$(time_revamped_bindings)
  case "${time_revamped_apply_command_sent}" in
  1) printf 'Applied. 1 key is bound.\n' ;;
  *) printf 'Applied. %s keys are bound.\n' "${time_revamped_apply_command_sent}" ;;
  esac
}

time_revamped_card_row() {
  TIME_REVAMPED_CARD="${TIME_REVAMPED_CARD}$1	${TIME_REVAMPED_OUT:--}
"
}

time_revamped_card_figure() {
  time_revamped_value "$2"
  time_revamped_card_row "$1"
}

time_revamped_card_styled() {
  time_revamped_value "$2"
  TIME_REVAMPED_OUT=$(printf '%s\n' "${TIME_REVAMPED_OUT}" | sed -e 's/#\[[^]]*\]//g')
  time_revamped_card_row "$1"
}

time_revamped_card_rows() {
  TIME_REVAMPED_CARD=""
  time_revamped_card_figure Time datetime
  time_revamped_card_figure ISO iso
  time_revamped_card_figure Epoch epoch
  time_revamped_card_figure Offset offset
  time_revamped_card_figure Week week
  time_revamped_card_figure "Day of year" doy
  time_revamped_card_styled Local local
  time_revamped_card_styled Zones zones
  time_revamped_card_figure Countdown until
  time_revamped_card_figure Stopwatch elapsed
  time_revamped_card_figure "Clock change" dst
  time_revamped_card_figure Overlap overlap
}

time_revamped_card() {
  time_revamped_load
  time_revamped_card_rows
  time_revamped_value iso
  time_revamped_card_closing="Read. It is ${TIME_REVAMPED_OUT}."
  if revamped_ui_out; then
    printf 'Figure\tValue\n%s' "${TIME_REVAMPED_CARD}" | revamped_ui_table
    revamped_ui_done "${time_revamped_card_closing}"
    return 0
  fi
  printf '%s' "${TIME_REVAMPED_CARD}" | awk -F '\t' '{ printf "%-14s %s\n", $1, $2 }'
  printf '%s\n' "${time_revamped_card_closing}"
}

time_revamped_status_command() {
  case " ${TIME_REVAMPED_METRICS} " in
  *" ${1:-} "*) time_revamped_status "$1" ;;
  *) time_revamped_status_refused "${1:-}" ;;
  esac
}

time_revamped_status_refused() {
  [ -n "$1" ] || time_revamped_usage "no placeholder given"
  time_revamped_bad "status must be datetime, date, clock, zones, local, until, elapsed, epoch, iso, offset, week, doy, dst or overlap, got: $1"
}

time_revamped_daemon_command() {
  set +e
  time_revamped_daemon
  time_revamped_daemon_command_ended=$?
  set -e
  [ "${time_revamped_daemon_command_ended}" -ne 0 ] || exec "${time_revamped_self}" daemon
}

time_revamped_start_menu() {
  revamped_cli_require_terminal
  time_revamped_start_menu_choice=$(revamped_cli_menu "Show the time now" "List the bindings" "Apply them now" "Check this machine" "Help")
  case "${time_revamped_start_menu_choice}" in
  "Show the time now") time_revamped_card ;;
  "List the bindings") time_revamped_list ;;
  "Apply them now") time_revamped_apply_command ;;
  "Check this machine") time_revamped_doctor ;;
  *) time_revamped_help ;;
  esac
}

time_revamped_dispatch() {
  case "${1:-}" in
  doctor) time_revamped_doctor ;;
  version | --version | -V) time_revamped_show_version ;;
  help | --help | -h) time_revamped_help ;;
  list) time_revamped_list ;;
  card) time_revamped_card ;;
  "") time_revamped_start_menu ;;
  *) revamped_cli_usage_error "unknown command '$1'" ;;
  esac
}

time_revamped_known() {
  [ "$1" != --theme ] || return 0
  time_revamped_known_name=$(time_revamped_setting_name "$1")
  [ -n "${time_revamped_known_name}" ] || time_revamped_usage "unknown option '$1'"
}

time_revamped_set() {
  time_revamped_set_upper=$(printf '%s\n' "$1" | tr '[:lower:]' '[:upper:]')
  export "TIME_REVAMPED_${time_revamped_set_upper}=$2"
}

time_revamped_option() {
  time_revamped_option_name=$(time_revamped_setting_name "$1")
  [ -n "${time_revamped_option_name}" ] || time_revamped_usage "unknown option '$1'"
  time_revamped_set "${time_revamped_option_name}" "$2"
}

time_revamped_check_values() {
  env | TIME_REVAMPED_ROWS="${TIME_REVAMPED_KINDS}" awk -F '=' '
    BEGIN {
      count = split(ENVIRON["TIME_REVAMPED_ROWS"], rows, "\n")
      for (i = 1; i <= count; i++) {
        at = index(rows[i], "\t")
        kind["TIME_REVAMPED_" toupper(substr(rows[i], 1, at - 1))] = substr(rows[i], at + 1)
      }
      kind["TIME_REVAMPED_INTERVAL"] = "minute"
    }
    $1 in kind {
      value = substr($0, length($1) + 2)
      if (value == "" || bad != "") { next }
      words = split(kind[$1], word, " ")
      if (word[1] == "number" && value !~ /^[0-9]+$/) { expect = "a whole number" }
      else if (kind[$1] == "minute" && value != "minute" && value !~ /^[0-9]+$/) { expect = "minute or a whole number" }
      else if (word[1] != "number" && kind[$1] != "minute") {
        found = 0
        for (i = 1; i <= words; i++) { if (value == word[i]) { found = 1 } }
        if (found) { next }
        expect = word[1]
        for (i = 2; i <= words; i++) { expect = expect (i == words ? " or " : ", ") word[i] }
      } else { next }
      name = tolower(substr($1, 15))
      gsub(/_/, "-", name)
      bad = name "\t" expect "\t" value
    }
    END { if (bad != "") { print bad } }
  '
}

time_revamped_check() {
  time_revamped_check_found=$(time_revamped_check_values)
  [ -z "${time_revamped_check_found}" ] || time_revamped_check_failed "${time_revamped_check_found}"
}

time_revamped_check_failed() {
  time_revamped_check_failed_rest="${1#*"${TIME_REVAMPED_TAB}"}"
  time_revamped_bad "--${1%%"${TIME_REVAMPED_TAB}"*} must be ${time_revamped_check_failed_rest%%"${TIME_REVAMPED_TAB}"*}, got: ${time_revamped_check_failed_rest#*"${TIME_REVAMPED_TAB}"}"
}

time_revamped_main() {
  time_revamped_theme="${TIME_REVAMPED_THEME:-}" time_revamped_as_json="" time_revamped_left=$# time_revamped_rest=0
  while [ "${time_revamped_left}" -gt 0 ]; do
    time_revamped_arg="$1"
    shift
    time_revamped_left=$((time_revamped_left - 1))
    case "${time_revamped_rest}:${time_revamped_arg}" in
    1:*) set -- "$@" "${time_revamped_arg}" ;;
    0:--) time_revamped_rest=1 ;;
    0:--json) time_revamped_as_json=1 ;;
    0:-h | 0:-V | 0:--help | 0:--version) set -- "$@" "${time_revamped_arg}" ;;
    0:--theme=*) time_revamped_theme="${time_revamped_arg#--theme=}" ;;
    0:--*=*) time_revamped_option "${time_revamped_arg%%=*}" "${time_revamped_arg#*=}" ;;
    0:--*)
      time_revamped_known "${time_revamped_arg}"
      [ "${time_revamped_left}" -gt 0 ] || time_revamped_usage "option '${time_revamped_arg}' needs a value"
      if [ "${time_revamped_arg}" = --theme ]; then
        time_revamped_theme="$1"
      else
        time_revamped_option "${time_revamped_arg}" "$1"
      fi
      shift
      time_revamped_left=$((time_revamped_left - 1))
      ;;
    0:-?*) time_revamped_usage "unknown option '${time_revamped_arg}'" ;;
    *) set -- "$@" "${time_revamped_arg}" ;;
    esac
  done
  time_revamped_check
  time_revamped_run "${time_revamped_theme}" "$@"
}

time_revamped_run() {
  time_revamped_run_theme="$1"
  shift
  [ -z "${time_revamped_as_json}" ] || [ "${1:-}" = list ] || time_revamped_usage "option '--json' works only with list"
  case "${1:-}" in
  apply) time_revamped_apply ;;
  status) time_revamped_status_command "${2:-}" ;;
  menu) time_revamped_menu ;;
  calendar) time_revamped_calendar ;;
  copy) time_revamped_copy "${2:-iso}" ;;
  mark) time_revamped_mark ;;
  toggle-format) time_revamped_toggle ;;
  daemon) time_revamped_daemon_command ;;
  *)
    time_revamped_interface
    revamped_cli_start "${time_revamped_run_theme}"
    time_revamped_dispatch "$@"
    ;;
  esac
}

time_revamped_main "$@"
